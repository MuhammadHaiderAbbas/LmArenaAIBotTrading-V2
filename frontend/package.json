{
  "name": "aurex-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "node ../scripts/check-rule-parity.mjs",
    "typecheck": "tsc -b",
    "check:parity": "node ../scripts/check-rule-parity.mjs",
    "preview": "vite preview",
    "e2e": "npm run build && playwright test",
    "e2e:deployed": "playwright test",
    "build:demo": "VITE_BUILD_TARGET=demo VITE_DEMO_MODE=true vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "prebuild:demo": "node ../scripts/check-rule-parity.mjs",
    "build:live": "VITE_BUILD_TARGET=live vite build --outDir dist-live && cp dist-live/live.html dist-live/index.html",
    "prebuild:live": "node ../scripts/check-rule-parity.mjs",
    "build:live:pages": "VITE_BUILD_TARGET=live vite build --outDir dist/live --emptyOutDir false && cp dist/live/live.html dist/live/index.html",
    "prebuild:live:pages": "node ../scripts/check-rule-parity.mjs",
    "build:pages": "npm run typecheck && npm run build:demo && npm run build:live:pages"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "5.108.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lightweight-charts": "5.3.0",
    "lucide-react": "1.78.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
