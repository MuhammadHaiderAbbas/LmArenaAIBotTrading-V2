# Copy to .env and adjust. Never commit .env.
AUREX_ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUREX_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
AUREX_COOKIE_SECURE=false
AUREX_ALLOW_REGISTRATION=true
AUREX_ACCESS_TOKEN_TTL_MINUTES=15
AUREX_REFRESH_TOKEN_TTL_DAYS=7
POSTGRES_PASSWORD=aurex
# For running the backend natively against the compose database:
# AUREX_DATABASE_URL=postgresql+asyncpg://aurex:aurex@localhost:5432/aurex
# Market data: "synthetic" (offline, default) or "live" (licensed feeds)
AUREX_MARKET_DATA_MODE=synthetic
# Live feeds (Phase 5). Finnhub = licensed US/UK stocks & ETFs; OANDA v20 = tradable FX
# bid/ask. Never commit keys; file variants work with Docker/Kubernetes secrets.
# AUREX_FINNHUB_API_KEY=
# AUREX_FINNHUB_API_KEY_FILE=/run/secrets/finnhub_api_key
# AUREX_OANDA_API_KEY=
# AUREX_OANDA_API_KEY_FILE=/run/secrets/oanda_api_key
# AUREX_OANDA_ACCOUNT_ID=
# Without OANDA credentials, live FX falls back to ECB fixings labelled ecb_reference
# and is never tradable; without a Finnhub key, live stocks/ETFs fail with 503.
# Research engine: "extractive" (offline, default) or "claude" (needs ANTHROPIC_API_KEY)
AUREX_RESEARCH_ENGINE=extractive
AUREX_LLM_MODEL=claude-opus-5-5
AUREX_LLM_EFFORT=high
# ANTHROPIC_API_KEY=   # set in your secret store, never commit
# Comma-separated https hosts admins may ingest from by URL/RSS (empty = disabled)
AUREX_RESEARCH_ALLOWED_HOSTS=

# Paper order matcher: seconds between passes over open limit/stop orders (0 disables)
AUREX_ORDER_MATCHER_INTERVAL_SECONDS=5
# Autopilot: minimum seconds between cycles for a RUNNING autopilot
AUREX_AUTOPILOT_INTERVAL_SECONDS=900

# --- Security (Phase 11) ---------------------------------------------------------------
# Secrets may be supplied as files instead (Docker/Kubernetes secrets):
# AUREX_JWT_SECRET_FILE=/run/secrets/jwt
# Key rotation: tokens signed with these previous secrets keep working until they expire.
# AUREX_JWT_PREVIOUS_SECRETS=
# Optional dedicated keys (default: derived from AUREX_JWT_SECRET)
# AUREX_DATA_KEY=          # encrypts TOTP seeds at rest
# AUREX_ARTIFACT_KEY=      # signs ML model artifacts
AUREX_API_RATE_LIMIT_PER_MINUTE=600
AUREX_LOGIN_LOCKOUT_FAILURES=20
AUREX_REGISTRATIONS_PER_IP_PER_HOUR=10
# AUREX_EXPOSE_API_DOCS=false   # default: on in development/test, off in staging/production

# --- Operations (Phase 12) --------------------------------------------------------------
# AUREX_REDIS_URL=redis://localhost:6379/0       # shared rate limits across replicas
# AUREX_STREAM_FANOUT_ENABLED=true               # Redis Streams fan-out for WebSockets
# AUREX_STREAM_NODE_ID=api-1                     # stable id per replica (optional)
# AUREX_METRICS_TOKEN=                           # enables /metrics (>=32 chars in production)
# AUREX_ALERTMANAGER_WEBHOOK_URL=                # alert delivery; required by the go-live gate
# OFFSITE_REMOTE=                                 # rclone remote/path for verified off-site copies
# AUREX_REQUIRE_ADMIN_MFA=                       # default: on outside development/test; cannot be false in staging/production
# AUREX_AUDIT_ANCHOR_FILE=/anchors/aurex-anchors.jsonl
# AUREX_AUDIT_ANCHOR_WEBHOOK_URL=
# AUREX_AUDIT_ANCHOR_WEBHOOK_SECRET=
# AUREX_BACKGROUND_WORKER=true                   # one replica is elected leader automatically
# AUREX_ML_DRIFT_MONITORING_ENABLED=true         # scheduled PSI/Brier checks in worker-once
# AUREX_ML_DRIFT_CHECK_INTERVAL_SECONDS=21600    # at most one check per model per 6h
# AUREX_ML_DRIFT_CHECK_WINDOW_DAYS=30            # recent window for drift comparison
# AUREX_OCR_ENABLED=true                         # OCR scanned PDF pages (needs tesseract)
# AUREX_POSITIONING_ENABLED=false                # crypto perp funding/open-interest feed
