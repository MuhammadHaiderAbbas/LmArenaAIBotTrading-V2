# Copy to .env.prod. Non-secret settings only: secrets live in ./secrets/ (see make-secrets.sh).
AUREX_DOMAIN=aurex.example.com
AUREX_IMAGE_OWNER=your-github-user
AUREX_VERSION=v1.0.0
AUREX_ALLOW_REGISTRATION=false
AUREX_MARKET_DATA_MODE=live
# Put vendor keys in ./secrets/finnhub_api_key and ./secrets/oanda_api_key (see make-secrets.sh).
AUREX_OANDA_ACCOUNT_ID=
# AUREX_METRICS_TOKEN_FILE is created by make-secrets.sh.
AUREX_ALERTMANAGER_WEBHOOK_URL=https://alertmanager.example.com/api/v2/alerts
OFFSITE_REMOTE=aurex-offsite
AUREX_STREAM_FANOUT_ENABLED=true
# Scheduled drift checks run through worker-once; they revoke eligibility, never retrain or promote.
AUREX_ML_DRIFT_MONITORING_ENABLED=true
AUREX_ML_DRIFT_CHECK_INTERVAL_SECONDS=21600
AUREX_ML_DRIFT_CHECK_WINDOW_DAYS=30
# Put the server-side Claude key in ./secrets/claude_api_key when RESEARCH_ENGINE=claude.
AUREX_RESEARCH_ENGINE=extractive
AUREX_OCR_ENABLED=true
# AUREX_AUDIT_ANCHOR_WEBHOOK_URL=https://anchors.example.org/aurex
BACKUP_AT=02:15
DRILL_WEEKDAY=7
BACKUP_RETENTION_DAYS=14
# BACKUP_GPG_RECIPIENT=ops@example.com
